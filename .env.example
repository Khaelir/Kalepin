# Kalepin Configuration

# Storage adapter: "localfs" (default) or "git"
STORAGE_ADAPTER=localfs

# Path to the vault directory (markdown files)
VAULT_PATH=/data/vault

# Path to the personal-folder root (per-user private namespace, virtual `_users/{email}/`).
# Peer to VAULT_PATH; created lazily on first authenticated request. Leave unset to
# disable personal folders (single-root rollback mode).
PERSONAL_PATH=/data/personal

# Path to the SQLite database file
DB_PATH=/data/db/kalepin.sqlite

# JWT secret (change this in production!)
JWT_SECRET=change-me-in-production

# JWT session expiry (e.g., "7d", "24h", "1h")
JWT_EXPIRY=7d

# Application URL (used in magic link emails AND OAuth discovery metadata).
# Behind a TLS-terminating reverse proxy this MUST be the public https URL.
APP_URL=http://localhost:3000

# Extra browser origins allowed to call /mcp, /oauth/*, /.well-known/oauth-*.
# https://claude.ai is always allowed; this only adds additional origins.
# OAUTH_CORS_ALLOW_LIST=https://example.com

# Set to "1" to disable OAuth consent approval (kill switch for staged rollout).
# OAUTH_CONSENT_DISABLED=1

# Comma-separated client_ids to pre-insert into oauth_clients at boot. Use only
# when an OAuth client (e.g. claude.ai) already has a connector registered with
# a hand-picked client_id that wasn't created via Dynamic Client Registration.
# OAUTH_PREREGISTERED_CLIENT_IDS=user@example.com

# Server port
PORT=3000

# Domain allowlist for login (comma-separated, or "*" for any domain)
DOMAIN_ALLOWLIST=*

# SMTP configuration for magic link emails (Mailjet)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kalepin.app

# Version history retention in days (default: 365)
VERSION_HISTORY_RETENTION_DAYS=365

# Admin emails (comma-separated). Only these users can create admin-scoped API keys.
# If unset, no one can access admin features (backup/restore via API or MCP).
# ADMIN_EMAILS=admin@example.com,another@example.com

# Encryption — at-rest envelope encryption (per-zone toggle in Settings → Admin → Encryption).
# Path to the KEK file. The runtime entrypoint normalizes the file at boot:
#   - 32 raw bytes → copied as-is to /run/kalepin/kek (mode 0600, uid 1000)
#   - 64 hex chars → decoded to 32 raw bytes at /run/kalepin/kek (same perms)
# After normalization KALEPIN_KEK_FILE is rewritten to /run/kalepin/kek so the
# backend's strict mode (0400|0600) and length (32B) checks pass even when the
# source is a Swarm-mounted secret (mode 0444) or hex pasted via Portainer.
# Generate locally for binary upload: `openssl rand -out kek 32 && chmod 0400 kek`.
# Generate hex for paste-into-Portainer:  `openssl rand -hex 32`.
# KALEPIN_KEK_FILE=/run/secrets/kalepin_kek

# Dev convenience: when KALEPIN_KEK_FILE is set but the file does not exist, auto-generate
# a fresh KEK at mode 0600. NEVER enable in production — losing this KEK means losing all
# encrypted data.
# KALEPIN_KEK_AUTO_GENERATE=1

# Dev/test fallback: hex-encoded 32-byte KEK. Refused when NODE_ENV=production unless
# KALEPIN_KEK_FILE is also set (which makes this value moot).
# KALEPIN_KEK=

# Frontend feature flags (read at `vite build` / `vite dev` time).
# Enables the Encrypted Folder UI. Backend pipeline is always live; the UI is
# gated until editor parity ships.
# E2E_SECURE_FOLDER=false

# S3 Backup (opt-in: set S3_BACKUP_BUCKET to enable)
# S3_BACKUP_BUCKET=my-kalepin-backups
# S3_BACKUP_REGION=us-east-1
# S3_BACKUP_ACCESS_KEY_ID=
# S3_BACKUP_SECRET_ACCESS_KEY=
# S3_BACKUP_PREFIX=backups
# S3_BACKUP_SCHEDULE=0 3 * * *
# S3_BACKUP_RETENTION_DAYS=30
# S3_BACKUP_ENDPOINT=https://minio.example.com
